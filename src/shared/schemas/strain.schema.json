{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "slug", "genotype"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string" },
    "name": { "type": "string" },
    "breeder": { "type": "string" },
    "genotype": {
      "type": "object",
      "required": ["sativa", "indica", "ruderalis"],
      "properties": {
        "sativa": { "type": "number" },
        "indica": { "type": "number" },
        "ruderalis": { "type": "number" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["draft", "published"] },
        "version": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["status", "version", "createdAt", "updatedAt"]
    }
  },
  "additionalProperties": true
}
