{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weed-breed.dev/schemas/device.schema.json",
  "title": "Weed Breed – Device",
  "type": "object",
  "required": ["id", "kind", "name", "quality", "complexity", "settings"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "kind": {
      "type": "string",
      "enum": ["Lamp", "ClimateUnit", "CO2Injector", "Dehumidifier", "HumidityControlUnit"]
    },
    "name": { "type": "string", "minLength": 1 },
    "quality": { "type": "number", "minimum": 0, "maximum": 1 },
    "complexity": { "type": "number", "minimum": 0, "maximum": 1 },
    "settings": { "type": "object" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "advantages": { "type": "array", "items": { "type": "string" } },
        "disadvantages": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  },
  "allOf": [
    { "$ref": "#/$defs/Lamp" },
    { "$ref": "#/$defs/ClimateUnit" },
    { "$ref": "#/$defs/CO2Injector" },
    { "$ref": "#/$defs/Dehumidifier" },
    { "$ref": "#/$defs/HumidityControlUnit" }
  ],
  "$defs": {
    "ClimateUnit": {
      "properties": { "kind": { "const": "ClimateUnit" } },
      "required": ["settings"],
      "allOf": [{
        "properties": {
          "settings": {
            "type": "object",
            "required": ["power", "coolingCapacity", "airflow", "targetTemperature"],
            "additionalProperties": false,
            "properties": {
              "power": { "type": "number", "minimum": 0, "description": "Electrical power draw at full load (kW)" },
              "coolingCapacity": { "type": "number", "minimum": 0, "description": "Nominal sensible cooling capacity (kW)" },
              "airflow": { "type": "number", "minimum": 0, "description": "Air flow rate (m3/h)" },
              "targetTemperature": { "type": "number", "description": "Target room air temperature (°C)" },
              "targetTemperatureRange": { "$ref": "#/$defs/numRange2" },
              "cop": { "type": "number", "minimum": 0, "description": "Coefficient of Performance (dimensionless)" },
              "hysteresisK": { "type": "number", "minimum": 0 },
              "fullPowerAtDeltaK": { "type": "number", "minimum": 0 }
            }
          }
        }
      }]
    },
    "Lamp": {
      "properties": { "kind": { "const": "Lamp" } },
      "required": ["settings"],
      "allOf": [{
        "properties": {
          "settings": {
            "type": "object",
            "required": ["power", "ppf", "coverageArea"],
            "additionalProperties": false,
            "properties": {
              "power": { "type": "number", "minimum": 0, "description": "Electrical power draw (kW)" },
              "ppf": { "type": "number", "minimum": 0, "description": "Photosynthetic Photon Flux (µmol/s)" },
              "coverageArea": { "type": "number", "minimum": 0, "description": "Effective area coverage at working height (m2)" },
              "heatFraction": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }]
    },
    "CO2Injector": {
      "properties": { "kind": { "const": "CO2Injector" } },
      "required": ["settings"],
      "allOf": [{
        "properties": {
          "settings": {
            "type": "object",
            "required": ["power", "targetCO2"],
            "additionalProperties": false,
            "properties": {
              "power": { "type": "number", "minimum": 0 },
              "targetCO2": { "type": "number", "minimum": 0 },
              "hysteresis": { "type": "number", "minimum": 0 },
              "pulsePpmPerTick": { "type": "number", "minimum": 0 }
            }
          }
        }
      }]
    },
    "Dehumidifier": {
      "properties": { "kind": { "const": "Dehumidifier" } },
      "required": ["settings"],
      "allOf": [{
        "properties": {
          "settings": {
            "type": "object",
            "required": ["power"],
            "additionalProperties": false,
            "properties": {
              "power": { "type": "number", "minimum": 0 },
              "waterKgPerHour": { "type": "number", "minimum": 0 }
            }
          }
        }
      }]
    },
    "HumidityControlUnit": {
      "properties": { "kind": { "const": "HumidityControlUnit" } },
      "required": ["settings"],
      "allOf": [{
        "properties": {
          "settings": {
            "type": "object",
            "required": ["power"],
            "additionalProperties": false,
            "properties": {
              "power": { "type": "number", "minimum": 0 },
              "targetHumidity": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }]
    },
    "numRange2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    }
  }
}
