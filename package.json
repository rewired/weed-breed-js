{
  "name": "weed-breed-js",
  "version": "1.0.0",
  "description": "A game of breeding weed",
  "license": "MIT",
  "author": "bjoern ahlers",
  "type": "module",
  "main": "src/server/index.mjs",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env NODE_ENV=development node --watch src/server/index.mjs",
    "dev:client": "vite --host --port 5173 --strictPort",
    "build": "vite build",
    "start": "node src/server/index.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "sim:demo": "node scripts/sim_demo.mjs",
    "sim": "node scripts/sim_from_save.mjs",
    "audit:last": "node scripts/audit_last.mjs",
    "lint": "npx eslint@8 .",
    "validate:data": "node scripts/validate_data.mjs",
    "test:unit": "npm test -- tests/unit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lodash": "^4.17.21",
    "pino": "^9.8.0",
    "pino-pretty": "^13.1.1",
    "rxjs": "^7.8.2",
    "seedrandom": "^3.0.5",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "xstate": "^5.20.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "jest": "^30.0.5",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "packageManager": "npm@^10"
}
