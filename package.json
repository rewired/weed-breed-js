{
  "name": "weed-breed-js",
  "version": "1.0.0",
  "description": "A game of breeding weed",
  "license": "MIT",
  "author": "bjoern ahlers",
  "type": "module",
  "main": "src/server/index.mjs",
  "scripts": {
    "dev:server": "node --watch src/server/index.mjs",
    "dev:client": "vite --host --config vite.config.mjs",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "start": "node src/server/index.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "sim": "node src/demos/structure_rooms_zones_demo.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lodash": "^4.17.21",
    "pino": "^9.8.0",
    "pino-pretty": "^13.1.1",
    "rxjs": "^7.8.2",
    "seedrandom": "^3.0.5",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "xstate": "^5.20.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "jest": "^30.0.5",
    "vite": "^7.1.3",
    "@vitejs/plugin-react": "^4.7.0"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "packageManager": "npm@^10"
}
